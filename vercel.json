{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs"
    },
    "api": {
      "root": "apps/api",
      "entrypoint": "src/app.ts",
      "framework": "express"
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": {
        "service": "api",
        "path": "/"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api",
        "path": "/$1"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web",
        "path": "/$1"
      }
    }
  ],
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "* * * * *"
    }
  ]
}
