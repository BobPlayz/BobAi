{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "entrypoint": "apps/web",
      "routePrefix": "/",
      "framework": "nextjs"
    },
    "api": {
      "entrypoint": "apps/api/src/app.ts",
      "routePrefix": "/api",
      "framework": "express"
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": {
        "service": "api",
        "path": "/"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api",
        "path": "/$1"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web",
        "path": "/$1"
      }
    }
  ]
}
