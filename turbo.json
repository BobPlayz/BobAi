{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false
    }
  },
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "RESEND_API_KEY",
    "RESEND_FROM_EMAIL",
    "BOBAI_MODEL_PROVIDER",
    "OPENROUTER_API_KEY",
    "BOBAI_OPENROUTER_MODEL",
    "BOBAI_OPENROUTER_CODING_MODEL"
  ]
}
