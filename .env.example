# Local development values. Do not copy this file into Vercel: on Vercel, leave NODE_ENV and the localhost URLs out.
NODE_ENV=development
PORT=3001
DATABASE_URL=
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_SECONDS=60
DB_CONNECT_TIMEOUT_SECONDS=10
DB_MAX_LIFETIME_SECONDS=1800
DB_DISABLE_PREPARED_STATEMENTS=false
CORS_ORIGIN=http://localhost:3000
BOBAI_WEB_URL=http://localhost:3000
BOBAI_AUTH_REDIRECT_BASE_URL=http://localhost:3001
TRUST_PROXY=false
TRUST_PROXY_HOPS=1
JSON_BODY_LIMIT=2mb
IMAGE_JSON_BODY_LIMIT=12mb
VISION_JSON_BODY_LIMIT=17mb
CHAT_JSON_BODY_LIMIT=5mb
VOICE_JSON_BODY_LIMIT=34mb
MEDIA_JSON_BODY_LIMIT=44mb
API_REQUEST_TIMEOUT_MS=180000
API_KEEP_ALIVE_TIMEOUT_MS=5000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
# Optional: true shares rate limits through PostgreSQL; false uses per-instance in-memory limits.
BOBAI_DISTRIBUTED_RATE_LIMIT=false
BOBAI_TOOLS_ENABLED=true
BOBAI_AGENT_KEY=
BOBAI_AGENT_CONCURRENCY=2
BOBAI_AGENT_MAX_ATTEMPTS=2
BOBAI_CODING_AGENTS_DIR=
BOBAI_CODING_AGENT_URL=
BOBAI_CODING_AGENT_KEY=
BOBAI_CODING_AGENT_SANDBOX_ATTESTED=false
BOBAI_MFA_ENCRYPTION_KEY=
BOBAI_TERMS_VERSION=
BOBAI_TERMS_URL=https://example.com/terms
BOBAI_PRIVACY_URL=https://example.com/privacy
BOBAI_LEGAL_CONTACT=
BOBAI_LEGAL_REVIEWED=false
BOBAI_ADMIN_EMAILS=
BOBAI_GOOGLE_CLIENT_ID=
BOBAI_GOOGLE_CLIENT_SECRET=
BOBAI_GITHUB_CLIENT_ID=
BOBAI_GITHUB_CLIENT_SECRET=
BOBAI_APPLE_CLIENT_ID=
BOBAI_APPLE_TEAM_ID=
BOBAI_APPLE_KEY_ID=
BOBAI_APPLE_PRIVATE_KEY=
# Login codes by SMTP, e.g. Gmail with an app password: smtp.gmail.com, port 465, your address as user and from.
BOBAI_EMAIL_PROVIDER=
BOBAI_SMTP_HOST=
BOBAI_SMTP_PORT=587
BOBAI_SMTP_SECURE=
BOBAI_SMTP_USER=
BOBAI_SMTP_PASSWORD=
BOBAI_SMTP_FROM=Jarvis <noreply@example.com>
# Resend is preferred for OTP email. Use a verified sender/domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Local development only: prints OTPs to the terminal if explicitly enabled.
BOBAI_DEV_LOG_OTP=false
# Ollama endpoint: local (http://127.0.0.1:11434), your gateway tunnel, or Ollama Cloud (https://ollama.com + BOBAI_OLLAMA_API_KEY).
# Models are discovered and picked automatically (docs/MODEL_ROUTING.md). BOBAI_OLLAMA_MODEL is an optional preference.
BOBAI_OLLAMA_BASE_URL=http://127.0.0.1:11434
# Only for an authenticated remote gateway (for example the Jarvis companion bridge). Leave empty for local Ollama.
BOBAI_OLLAMA_API_KEY=
BOBAI_OLLAMA_MODEL=
BOBAI_MODEL_ROUTING=auto
BOBAI_OLLAMA_EMBEDDING_MODEL=disabled
BOBAI_OLLAMA_TIMEOUT_MS=120000
BOBAI_OLLAMA_NUM_CTX=4096
BOBAI_OLLAMA_NUM_PREDICT=1024
BOBAI_OLLAMA_THINK=false
BOBAI_PROVIDER_TIMEOUT_MS=120000
BOBAI_PYTHON=python
BOBAI_VOICE_PYTHON=
BOBAI_WHISPER_PYTHON_MODEL_PATH=
# Image generation stays local/offline after the model download. No hosted image API is required.
BOBAI_IMAGE_PROFILE=fast
BOBAI_IMAGE_MODEL_PATH=models/image/tiny-sd
# Optional: higher-quality web results; without a key, DuckDuckGo is used.
BOBAI_BRAVE_SEARCH_API_KEY=
# Optional: free key from https://cricketdata.org for real live cricket scores (otherwise web search is used).
BOBAI_CRICKET_API_KEY=
BOBAI_RESEARCH_TIMEOUT_MS=20000
BOBAI_DEEP_RESEARCH_MAX_SOURCES=24
BOBAI_FILE_STORAGE_DIR=storage/objects
# Production requires a scanner (BOBAI_MALWARE_SCANNER_URL) unless this is explicitly set to false.
# Leave empty for the default: required in production, optional in development.
BOBAI_MALWARE_SCAN_REQUIRED=
BOBAI_MALWARE_SCANNER_URL=
# Voice/image runtimes unload the chat model only when free RAM drops below this many MB.
BOBAI_MEDIA_MIN_FREE_MB=1200
# Local offline Piper voice assets. Paths point to .onnx files from Ai-Glasses.
BOBAI_PIPER_EN_MODEL_PATH=
BOBAI_PIPER_EN_CONFIG_PATH=
BOBAI_PIPER_TE_MODEL_PATH=
BOBAI_PIPER_TE_CONFIG_PATH=
BOBAI_ESPEAK_DATA_PATH=
BOBAI_WHISPER_MODEL_PATH=
BOBAI_PIPER_COMMAND=
BOBAI_WHISPER_COMMAND=
BOBAI_FFMPEG_COMMAND=
BOBAI_FFPROBE_COMMAND=
BOBAI_PIPER_ROOT=
BOBAI_WHISPER_ROOT=
BOBAHS_PORT=8787
BOBAHS_HOST=127.0.0.1
BOBAHS_MODE=controller
BOBAHS_CONTROLLER_TOKEN=
BOBAHS_JOIN_TOKEN=
BOBAHS_CONTROLLER_URL=
BOBAHS_NODE_ID=
BOBAHS_NODE_TOKEN=
BOBAHS_POLL_MS=5000
NEXT_PUBLIC_TERMS_VERSION=2026-10-13
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_DOMAIN=
NEXT_PUBLIC_ANALYTICS_DOMAIN=

# Ollama gateway (only if the hosted site should use Ollama on this PC; see docs/OLLAMA_GATEWAY.md)
GATEWAY_TOKEN=
GATEWAY_ALLOWED_MODELS=*
