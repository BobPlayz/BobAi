NODE_ENV=development
PORT=3001
DATABASE_URL=
CORS_ORIGIN=http://localhost:3000
BOBAI_WEB_URL=http://localhost:3000
BOBAI_AUTH_REDIRECT_BASE_URL=http://localhost:3001
TRUST_PROXY=false
TRUST_PROXY_HOPS=1
JSON_BODY_LIMIT=2mb
API_REQUEST_TIMEOUT_MS=180000
API_KEEP_ALIVE_TIMEOUT_MS=5000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
BOBAI_AGENT_KEY=
BOBAI_AGENT_CONCURRENCY=2
BOBAI_AGENT_MAX_ATTEMPTS=2
BOBAI_CODING_AGENTS_DIR=
BOBAI_CODING_AGENT_URL=http://127.0.0.1:3456
BOBAI_CODING_AGENT_KEY=
BOBAI_CODING_AGENT_SANDBOX_ATTESTED=false
BOBAI_MFA_ENCRYPTION_KEY=
BOBAI_TERMS_VERSION=
BOBAI_TERMS_URL=https://example.com/terms
BOBAI_PRIVACY_URL=https://example.com/privacy
BOBAI_LEGAL_CONTACT=
BOBAI_LEGAL_REVIEWED=false
BOBAI_ADMIN_EMAILS=

# Optional social sign-in.
BOBAI_GOOGLE_CLIENT_ID=
BOBAI_GOOGLE_CLIENT_SECRET=
BOBAI_GITHUB_CLIENT_ID=
BOBAI_GITHUB_CLIENT_SECRET=
BOBAI_APPLE_CLIENT_ID=
BOBAI_APPLE_TEAM_ID=
BOBAI_APPLE_KEY_ID=
BOBAI_APPLE_PRIVATE_KEY=

# Optional SMTP for real external email.
BOBAI_SMTP_HOST=
BOBAI_SMTP_PORT=587
BOBAI_SMTP_USER=
BOBAI_SMTP_PASSWORD=
BOBAI_SMTP_FROM=BobAI <noreply@example.com>

# BobAI native model. No external inference server is used.
BOBAI_NATIVE_MODEL_DIR=model-training/output/bob-0.1-native
BOBAI_MODEL_NAME=bob-0.1-native
BOBAI_CODING_MODEL_NAME=bob-0.1-native
BOBAI_PROVIDER_TIMEOUT_MS=120000

# Local research, storage, voice, and media.
BOBAI_RESEARCH_TIMEOUT_MS=20000
BOBAI_FILE_STORAGE_DIR=storage/objects
BOBAI_PIPER_COMMAND=piper
BOBAI_PIPER_MODEL_PATH=
BOBAI_WHISPER_COMMAND=whisper-cli
BOBAI_WHISPER_MODEL_PATH=
BOBAI_FFMPEG_COMMAND=ffmpeg
BOBAI_FFPROBE_COMMAND=ffprobe
