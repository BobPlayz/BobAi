BOBAI_IMAGE_EDIT_PROVIDER_KEY=
BOBAI_DESIGN_PROVIDER_URL=
BOBAI_DESIGN_PROVIDER_KEY=
BOBAI_VOICE_PROVIDER_URL=
BOBAI_VOICE_PROVIDER_KEY=
BOBAI_MUSIC_PROVIDER_URL=
BOBAI_MUSIC_PROVIDER_KEY=
BOBAI_AUTOMATION_ENABLED=false
