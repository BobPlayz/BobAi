NODE_ENV=development
PORT=3001
DATABASE_URL=
CORS_ORIGIN=http://localhost:3000
BOBAI_WEB_URL=http://localhost:3000
TRUST_PROXY=false
TRUST_PROXY_HOPS=1
JSON_BODY_LIMIT=2mb
API_REQUEST_TIMEOUT_MS=180000
API_KEEP_ALIVE_TIMEOUT_MS=5000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
BOBAI_AGENT_KEY=
BOBAI_AGENT_CONCURRENCY=2
BOBAI_AGENT_MAX_ATTEMPTS=2
BOBAI_CODING_AGENTS_DIR=
BOBAI_CODING_AGENT_URL=http://127.0.0.1:3456
BOBAI_CODING_AGENT_KEY=
BOBAI_CODING_AGENT_SANDBOX_ATTESTED=false
BOBAI_MFA_ENCRYPTION_KEY=
BOBAI_TERMS_VERSION=
BOBAI_TERMS_URL=https://example.com/terms
BOBAI_PRIVACY_URL=https://example.com/privacy
BOBAI_LEGAL_CONTACT=
BOBAI_LEGAL_REVIEWED=false
BOBAI_ADMIN_EMAILS=

# Core LLMs. Ollama is intentionally not part of the BobAI architecture.
# Both endpoints must expose POST /v1/chat/completions.
BOBAI_MODEL_URL=
BOBAI_MODEL_KEY=
BOBAI_MODEL_NAME=bob
BOBAI_CODING_MODEL_URL=
BOBAI_CODING_MODEL_KEY=
BOBAI_CODING_MODEL_NAME=coder
BOBAI_CODING_FAST_MODEL_NAME=coder-fast
BOBAI_PROVIDER_TIMEOUT_MS=120000
BOBAI_PROVIDER_RETRIES=2

# Embeddings. The endpoint must return { data: [{ embedding: number[] }] } with 1536 values.
BOBAI_EMBEDDING_PROVIDER_URL=
BOBAI_EMBEDDING_PROVIDER_TOKEN=
BOBAI_EMBEDDING_MODEL=

# Optional external capability providers.
BOBAI_VISION_PROVIDER_URL=
BOBAI_VISION_PROVIDER_TOKEN=
BOBAI_VISION_MODEL=
BOBAI_VISION_TIMEOUT_MS=120000
BOBAI_RESEARCH_PROVIDER_URL=
BOBAI_RESEARCH_PROVIDER_KEY=
BOBAI_RESEARCH_TIMEOUT_MS=20000
BOBAI_BROWSER_PROVIDER_URL=
BOBAI_BROWSER_PROVIDER_KEY=
BOBAI_VIDEO_PROVIDER_URL=
BOBAI_VIDEO_PROVIDER_KEY=
BOBAI_VIDEO_EDIT_PROVIDER_URL=
BOBAI_VIDEO_EDIT_PROVIDER_KEY=
BOBAI_TALKING_AVATAR_PROVIDER_URL=
BOBAI_TALKING_AVATAR_PROVIDER_KEY=
