{
  "name": "jarvis",
  "description": "Jarvis core AI platform",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "web": "npm run dev --workspace=web",
    "api": "npm run dev --workspace=@bobai/api",
    "serve:lhci": "npm run start --workspace=web",
    "bobredis": "tsx scripts/bobredis/index.ts",
    "ai": "tsx scripts/start.ts",
    "bobhs": "npm run dev --workspace=@bobai/bobhs",
    "bobhs:build": "npm run build --workspace=@bobai/bobhs",
    "bobhs:test": "npm run test --workspace=@bobai/bobhs",
    "bobhs:start": "npm run start --workspace=@bobai/bobhs",
    "native:media:build": "node-gyp rebuild --directory native/media --release",
    "native:media:clean": "node-gyp clean --directory native/media",
    "db:push": "npm run db:push --workspace=@bobai/db",
    "db:generate": "npm run db:generate --workspace=@bobai/db",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:migrate:drizzle": "npm run db:migrate --workspace=@bobai/db",
    "db:backup": "tsx scripts/db-backup.ts",
    "db:backup:verify": "tsx scripts/db-backup-verify.ts",
    "account:delete": "tsx scripts/account-deletion.ts",
    "build": "npm run build --workspace=@bobai/api && npm run build --workspace=@bobai/bobhs && npm run build --workspace=web",
    "test:api": "npm run test:security --workspace=@bobai/api && npm run test:local-media --workspace=@bobai/api && tsx --test apps/api/tests/modelProvider.test.ts apps/api/tests/resendDelivery.test.ts apps/api/tests/research.test.ts apps/api/tests/agentOrchestration.test.ts apps/api/tests/backend-final.test.ts apps/api/tests/executionGuard.test.ts apps/api/tests/platformPrimitives.test.ts apps/api/tests/toolDecision.test.ts apps/api/tests/toolLoop.test.ts apps/api/tests/imagePrompt.test.ts apps/api/tests/wavSafety.test.ts apps/api/tests/httpSafety.test.ts apps/api/tests/emotionalState.test.ts apps/api/tests/modelRuntime.test.ts",
    "test": "npm run test:api && npm run test --workspace=@bobai/bobhs",
    "audit": "npm audit --workspaces --include-workspace-root",
    "smoke": "tsx scripts/smoke.ts",
    "repo:preflight": "node scripts/repo-preflight.mjs"
  },
  "overrides": {
    "esbuild": "^0.28.2",
    "js-yaml": ">=4.3.2",
    "qs": ">=6.16.0",
    "brace-expansion": "5.0.12",
    "braces": "3.0.3",
    "proxy-addr": "2.0.8",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2"
  },
  "devDependencies": {
    "@types/multer": "^2.2.0",
    "tsx": "^4.20.3"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.31.1",
    "motion": "^13.2.0",
    "multer": "^2.3.1",
    "pdf-parse": "^2.4.5",
    "postgres": "^3.4.9",
    "react-icons": "^5.7.0",
    "tesseract.js": "^7.0.0",
    "three": "^0.186.0"
  }
}
