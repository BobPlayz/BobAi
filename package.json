{
  "name": "bobai",
  "description": "BobAI core AI platform",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "web": "npm run dev --workspace=web",
    "api": "npm run dev --workspace=@bobai/api",
    "serve:lhci": "npm run start --workspace=web",
    "bobredis": "tsx scripts/bobredis/index.ts",
    "ai": "tsx scripts/start.ts",
    "bobhs": "npm run dev --workspace=@bobai/bobhs",
    "bobhs:build": "npm run build --workspace=@bobai/bobhs",
    "bobhs:start": "npm run start --workspace=@bobai/bobhs",
    "native:media:build": "node-gyp rebuild --directory native/media --release",
    "native:media:clean": "node-gyp clean --directory native/media",
    "db:push": "npm run db:push --workspace=@bobai/db",
    "db:generate": "npm run db:generate --workspace=@bobai/db",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:migrate:drizzle": "npm run db:migrate --workspace=@bobai/db",
    "db:backup": "tsx scripts/db-backup.ts",
    "db:backup:verify": "tsx scripts/db-backup-verify.ts",
    "account:delete": "tsx scripts/account-deletion.ts",
    "model:prepare": "python model-training/prepare_dataset.py",
    "model:train": "python model-training/train.py",
    "model:evaluate": "python model-training/evaluate.py",
    "model:specialist": "python model-training/train_specialist.py",
    "build": "npm run build --workspace=@bobai/api && npm run build --workspace=@bobai/bobhs && npm run build --workspace=web",
    "test": "npm run test:security --workspace=@bobai/api && npm run test:local-media --workspace=@bobai/api",
    "audit": "npm audit --workspaces --include-workspace-root",
    "smoke": "tsx scripts/smoke.ts"
  },
  "overrides": {
    "esbuild": "^0.28.2",
    "js-yaml": ">=4.3.2",
    "qs": ">=6.16.0"
  },
  "devDependencies": {
    "@types/multer": "^2.2.0",
    "tsx": "^4.20.3"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.31.1",
    "motion": "^13.1.1",
    "multer": "^2.3.0",
    "pdf-parse": "^2.4.5",
    "postgres": "^3.4.9",
    "react-icons": "^5.7.0",
    "tesseract.js": "^7.0.0",
    "three": "^0.185.1"
  }
}
