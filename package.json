{
  "name": "bobai",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "web": "npm run dev --workspace=web",
    "api": "npm run dev --workspace=@bobai/api",
    "ai": "tsx scripts/start.ts",
    "db:push": "npm run db:push --workspace=@bobai/db",
    "db:generate": "npm run db:generate --workspace=@bobai/db",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:migrate:drizzle": "npm run db:migrate --workspace=@bobai/db",
    "build": "npm run build --workspace=@bobai/api && npm run build --workspace=web",
    "test": "npm run test:security --workspace=@bobai/api",
    "audit": "npm audit --workspaces --include-workspace-root",
    "smoke": "tsx scripts/smoke.ts"
  },
  "devDependencies": {
    "@types/multer": "^2.0.0",
    "tsx": "^4.20.3"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "gsap": "^3.15.0",
    "lucide-react": "^0.468.0",
    "motion": "^13.1.1",
    "multer": "^2.2.0",
    "pdf-parse": "^2.4.5",
    "postgres": "^3.4.9",
    "react-icons": "^5.7.0",
    "tesseract.js": "^7.0.0",
    "three": "^0.185.1"
  }
}
